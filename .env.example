# Copy to .env; start using: node --env-file=.env server/index.js (after npm run build)
# Leave these empty to retain anonymous mode. Never commit .env.
LODESTAR_ISSUER=https://lodestar-rho.vercel.app
LODESTAR_CLIENT_ID=
LODESTAR_REDIRECT_URI=
SESSION_SECRET=
AUTH_REQUIRED=0
PORT=5173
HOST=127.0.0.1
# Example public settings after Lodestar client approval:
# LODESTAR_CLIENT_ID=ldi_client_dawn_laundry_dev
# LODESTAR_REDIRECT_URI=http://localhost:5173/auth/lodestar/callback
# Generate SESSION_SECRET locally, at least 32 random bytes; never copy it to a report.
